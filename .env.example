# 本機或 Neon / Supabase 的 PostgreSQL 連線字串
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/couple_money"
# migration 用的直連字串（Neon 的 unpooled；本機填跟上面一樣）
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/couple_money"

# ── 照片／頭貼的儲存位置（選填，本機不用設）──
# local（預設，寫到 UPLOAD_DIR）或 blob（Vercel Blob）。
# 留空時：有 BLOB_READ_WRITE_TOKEN 就用 blob，否則用 local。
# STORAGE_DRIVER="local"
# UPLOAD_DIR=".uploads"
# 部署到 Vercel 時，Blob store connect 之後會自動注入 BLOB_READ_WRITE_TOKEN，不要寫在這裡。

# 把收據／打卡照片／頭貼的上傳入口整個關掉（選填）
# NEXT_PUBLIC_PHOTOS_ENABLED="0"
